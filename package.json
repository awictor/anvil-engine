{
  "name": "anvil-engine",
  "version": "1.0.0",
  "description": "Independent browser-as-a-service engine — zero third-party browser infra dependencies",
  "type": "module",
  "main": "dist/api.js",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "types": "dist/client.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/api.js",
    "dev": "tsx src/api.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "puppeteer-core": "^24.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0"
  }
}
